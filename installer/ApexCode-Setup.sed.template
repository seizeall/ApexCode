[Version]
Class=IEXPRESS
SEDVersion=3
[Options]
PackagePurpose=InstallApp
ShowInstallProgramWindow=0
HideExtractAnimation=1
UseLongFileName=1
InsideCompressed=0
CAB_FixedSize=0
CAB_ResvCodeSigning=0
RebootMode=N
InstallPrompt=
DisplayLicense=
FinishMessage=ApexCode installation completed. Configure .env, then use the desktop shortcut.
TargetName={{TARGET}}
FriendlyName=ApexCode Setup
AppLaunched=powershell.exe -NoProfile -ExecutionPolicy Bypass -File install.ps1
PostInstallCmd=<None>
AdminQuietInstCmd=
UserQuietInstCmd=
SourceFiles=SourceFiles
[Strings]
FILE0="ApexCode.exe"
FILE1=".env.example"
FILE2="README.txt"
FILE3="API_CONFIG.md"
FILE4="DEMO_GUIDE.md"
FILE5="install.ps1"
[SourceFiles]
SourceFiles0={{RELEASE}}\
SourceFiles1={{INSTALLER}}\
[SourceFiles0]
%FILE0%=
%FILE1%=
%FILE2%=
%FILE3%=
%FILE4%=
[SourceFiles1]
%FILE5%=
